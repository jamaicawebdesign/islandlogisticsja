{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "format": "uri", "description": "User's profile photo URL" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User's role in the system" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user profile was created" }
      },
      "required": ["uid", "email", "role"]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "A delivery shipment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string", "enum": ["In Transit", "Delivered", "Pending", "Delayed"] },
        "direction": { "type": "string", "enum": ["Inbound", "Outbound"] },
        "estimatedArrival": { "type": "string" },
        "value": { "type": "number" },
        "weight": { "type": "string" },
        "createdBy": { "type": "string", "description": "UID of the user who created the shipment" },
        "createdAt": { "type": "string", "format": "date-time" },
        "originLat": { "type": "number" },
        "originLng": { "type": "number" },
        "destLat": { "type": "number" },
        "destLng": { "type": "number" },
        "cargoType": { "type": "string" },
        "specialHandling": { "type": "string" }
      },
      "required": ["trackingNumber", "origin", "destination", "status", "direction", "createdBy"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "A fleet vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["Truck", "Van", "Ship", "Plane"] },
        "status": { "type": "string", "enum": ["Active", "Maintenance", "Idle"] },
        "location": { "type": "string" },
        "fuelLevel": { "type": "number" },
        "driver": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "weightCapacity": { "type": "string" },
        "volumeCapacity": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "status", "driver", "lat", "lng", "createdBy"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Scheduled vehicle maintenance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehicleId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "serviceType": { "type": "string", "enum": ["Routine", "Repair", "Inspection", "Oil Change", "Tire Rotation"] },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Scheduled", "Completed", "Cancelled"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vehicleId", "date", "time", "serviceType", "status", "createdBy"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "A warehouse inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "minStock": { "type": "number" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["In Stock", "Low Stock", "Out of Stock"] },
        "value": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "name", "quantity", "status", "createdBy"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "OrderItem" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processing", "Fulfilled", "Cancelled"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "shipmentId": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "items", "totalAmount", "status", "createdBy"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "An item in an order",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" }
      },
      "required": ["itemId", "sku", "name", "quantity", "price"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/shipments/{shipmentId}": {
      "schema": "Shipment",
      "description": "Global shipments"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Fleet vehicles"
    },
    "/maintenance/{maintenanceId}": {
      "schema": "Maintenance",
      "description": "Maintenance schedules"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Warehouse inventory"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
